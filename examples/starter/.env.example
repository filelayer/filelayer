# The only variable with no default. Any Postgres you own.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/filelayer_starter

# Where this example listens, and the base of the share URLs it mints.
PORT=3000
BASE_URL=http://localhost:3000

# The upload ceiling, enforced as the body arrives. Filelayer imposes none of
# its own, so without this the limit is whatever the process can allocate.
MAX_UPLOAD_BYTES=26214400

# Storage. Leave the S3_* block unset and bytes go to a local directory,
# which survives a restart and needs no bucket and no IAM user.
FILELAYER_DATA_DIR=./filelayer-data

# Set S3_ENDPOINT to switch to a bucket. The other three become required.
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_BUCKET=my-bucket
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
