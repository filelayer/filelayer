# Baseline 1 — every value here is an operational decision.
DATABASE_URL=postgres://vault:***@db.internal:5432/vault
S3_BUCKET=vault-prod
S3_REGION=eu-west-1
# Set for R2 / MinIO; leave unset for AWS S3.
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
PUBLIC_BASE_URL=https://app.vault.example
# proxy = immediate revocation (correct). redirect = cheaper, 30s fail-open window.
SHARE_DELIVERY=proxy
PORT=3000
