{
  "name": "@filelayer/core",
  "version": "0.14.0",
  "description": "Multi-tenant file authorization middleware and lifecycle for Postgres: a single decision point for public and private files, revocable URLs, delegated share links and a hash-chained audit trail.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./schema.sql": "./schema.sql",
    "./llms.txt": "./llms.txt",
    "./openapi.json": "./openapi.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "test",
    "examples",
    "docs",
    "schema.sql",
    "tsconfig.json",
    "tsconfig.build.json",
    "README.md",
    "CHANGELOG.md",
    "MIGRATIONS.md",
    "SEMANTICS.md",
    "LICENSE",
    "NOTICE",
    "llms.txt",
    "openapi.json",
    "TRUST.md",
    "SECURITY.md"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/filelayer/filelayer.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/filelayer/filelayer/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/filelayer/filelayer/issues"
  },
  "keywords": [
    "authorization",
    "access-control",
    "multi-tenant",
    "file-storage",
    "s3",
    "r2",
    "postgres",
    "audit-log",
    "share-links",
    "rbac",
    "signed-urls",
    "revocation"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node --eval \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepack": "npm run build",
    "test": "node --test --experimental-strip-types \"test/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm test && npm run build",
    "test:contention": "FILELAYER_TEST_CONTENTION=1 node --test --experimental-strip-types \"test/contention.test.ts\""
  },
  "peerDependencies": {
    "@electric-sql/pglite": "^0.3.11"
  },
  "peerDependenciesMeta": {
    "@electric-sql/pglite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.11",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "embedded-postgres": "^18.4.0-beta.17",
    "pg": "^8.23.1",
    "typescript": "^5.7.0"
  }
}
